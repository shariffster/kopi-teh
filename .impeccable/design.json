  "narrative": {
    "northStar": "The photographic mixing table",
    "overview": "The approved MagicPath A composition places a dominant ivory cup between an ingredient shelf and a paper recipe receipt, with familiar drinks along the bottom. It retains Befrothed's warm stone, photographic texture, quiet serif and tactile liquid. Interface elements are compact and secondary to the cup; they now make the pouring, recipe and serving actions explicit.\n\nThe user-requested focus mode removes the mixing table while retaining the same cup and recipe. A small toolbar can reveal ingredients, serve, or resume mixing. This document records the local source build on 11 October 2026; it does not establish deployment or device acceptance. The reviewed desktop and mobile captures show the cup composition. Refreshed mobile captures also confirm the visible About action, open cultural-notes dialog and three-column ingredient tray. Screenshot evidence establishes visible layout, not native-device performance.",
    "keyCharacteristics": [
      "Photographic ceramic and stone, with a registered circular WebGL liquid surface.",
      "Editorial serif headings paired with small, quiet sans-serif controls.",
      "A flat paper receipt and horizontal recipe carousel around one dominant cup.",
      "Optional cup-only focus with a compact ingredient tray."
    ],
    "rules": [
      {
        "name": "The Ingredient Identity Rule",
        "body": "Keep each ingredient's colour consistent across controls, receipt and recipe previews. Resulting liquid colours are artistic mixtures, not calibrated beverage measurements.",
        "section": "colors"
      },
      {
        "name": "The Registered Surface Rule",
        "body": "The photograph and interactive liquid window share the manifest's image coordinates. Never independently scale or reposition the liquid crop.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** preserve the photographic cup, warm stone and shared image/liquid registration.",
      "**Do** keep ingredient colours and units consistent across the shelf, receipt, carousel and focus tray.",
      "**Do** preserve the current drink when entering or leaving focus mode.",
      "**Do** distinguish source evidence, rendered screenshots and native-device testing."
    ],
    "donts": [
      "**Don't** restore the stale Befrothed claim that there is no surrounding interface; this build has an approved mixing table and carousel.",
      "**Don't** describe synthetic artwork as a camera photograph or illustrative recipes as standard stall ratios.",
      "**Don't** claim sensory, nutritional or chemistry accuracy from the colour simulation.",
      "**Don't** treat desktop or emulated mobile captures as proof of native phone performance, sustained frame rate or physical touch latency."
    ]
  }
